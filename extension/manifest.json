{
  "manifest_version": 3,
  "name": "Sözleşme Okuyucu",
  "short_name": "Sözleşme Okuyucu",
  "version": "0.1.0",
  "description": "Kullanım koşullarını ve gizlilik politikalarını bulur, özetler, risk puanı verir ve riskli maddeleri gösterir.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Sözleşme Okuyucu",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/extract.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "offscreen",
    "notifications",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"]
}
